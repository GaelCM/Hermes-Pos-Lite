{
    "appId": "com.electron.hermesPosLite",
    "icon": "./src/electron/logo.jpg",
    "files": [
        "package.json",
        "dist-react/**/*",
        "src/electron/**/*"
    ],
    "asar": false,
    "mac": {
        "target": [
            "dmg"
        ]
    },
    "win": {
        "target": [
            {
                "target": "portable",
                "arch": [
                    "x64",
                    "ia32"
                ]
            },
            {
                "target": "msi",
                "arch": [
                    "x64",
                    "ia32"
                ]
            }
        ]
    },
    "linux": {
        "target": [
            "AppImage"
        ]
    }
}